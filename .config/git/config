[color]
	ui = auto

[color "diff"]
	meta = yellow

[commit]
	gpgsign = true

[diff]
	renames = copies
	mnemonicprefix = true
	algorithm = histogram
	colorMoved = default

[push]
	default = current

[pull]
	rebase = true

[rebase]
	autoSquash = true

[rerere]
	enabled = false

[init]
	defaultBranch = main
; 	templatedir = ~/.git_template

[branch]
	sort = -committerdate

[alias]
	ctags = !.git/hooks/ctags

[pager]
	log = diff-highlight | less
	show = diff-highlight | less
	diff = diff-highlight | less

[merge]
	tool = diffconflicts

[mergetool "diffconflicts"]
	cmd = nvim -c DiffConflicts \"$MERGED\" \"$BASE\" \"$LOCAL\" \"$REMOTE\"
	trustExitCode = true

[mergetool]
	keepBackup = false

[include]
	path = config.private

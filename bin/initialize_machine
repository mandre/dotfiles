#!/bin/bash

read -p 'email: ' email

if grep -q "Red Hat Enterprise Linux" /etc/redhat-release; then
	INSTALLER=yum
	read -s -p 'RH subscription password: ' rh_password
	subscription-manager register --username="${email}" --password="${rh_password}"
	subscription-manager list --available
	read -p 'RH pool: ' rh_pool
	subscription-manager attach --pool="${rh_pool}"
elif grep -q "CentOS" /etc/redhat-release; then
	INSTALLER=yum
elif grep -q "Fedora" /etc/redhat-release; then
	INSTALLER=dnf
elif [ -f /etc/debian_version ]; then
	INSTALLER=apt-get
else
	echo "Unsupported distro"
	exit 1
fi

${INSTALLER} install -y \
	zsh \
	git \
	vim \
	tmux \
	mc \
	neovim \
	ripgrep

if ! id -u martin; then
	adduser martin
	usermod -G wheel martin
	passwd martin
fi

SSH_KEY=""

su - martin << EOF
set -x

mkdir -p ~/.ssh

if ! grep -q ${SSH_KEY} ~/.ssh/authorized_keys; then
	cat >> ~/.ssh/authorized_keys <<EOS
	ssh-rsa ${SSH_KEY} ${email}
EOS
fi

if ! [ -f ~/.ssh/id_rsa.pub ]; then
	ssh-keygen
fi

if ! [ -d dotfiles ]; then
	git clone https://github.com/mandre/dotfiles.git
else
	pushd dotfiles
	git pull
	popd
fi

mkdir -p ~/.config/zsh
if ! [ -d ~/.config/zsh/.zprezto ]; then
	git clone --recursive https://github.com/sorin-ionescu/prezto.git ~/.config/zsh/.zprezto
else
	pushd ~/.config/zsh/.zprezto
	git pull
	git submodules update
	popd
fi

ln -sf ~/dotfiles/.config/zsh/.zlogin ~/.config/zsh/
ln -sf ~/dotfiles/.config/zsh/.zpreztorc ~/.config/zsh/
ln -sf ~/dotfiles/.config/zsh/.zprofile ~/.config/zsh/
ln -sf ~/dotfiles/.config/zsh/.zshenv ~/.config/zsh/
ln -sf ~/dotfiles/.config/zsh/.zshrc ~/.config/zsh/

cat > ~/.zshenv <<'EOS'
export ZDOTDIR="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"
[[ -f "$ZDOTDIR/.zshenv" ]] && source "$ZDOTDIR/.zshenv"
EOS

mkdir -p ~/.local
ln -sf ~/dotfiles/bin ~/.local/bin
ln -sf ~/dotfiles/bin ~/bin

# Git
mkdir -p ~/.config/git
ln -sf ~/dotfiles/.config/git/config ~/.config/git/config
ln -sf ~/dotfiles/.config/git/template ~/.config/git/template
cat > ~/.config/git/config.private <<EOS
[user]
        name = Martin André
        email = ${email}
EOS

# Tmux
mkdir -p ~/.config/tmux/plugins
ln -sf ~/dotfiles/.config/tmux/tmux.conf ~/.config/tmux/tmux.conf
if ! [ -d ~/.config/tmux/plugins/tpm ]; then
	git clone https://github.com/tmux-plugins/tpm ~/.config/tmux/plugins/tpm
else
	pushd ~/.config/tmux/plugins/tpm
	git pull
	popd
fi

# FZF
mkdir -p ~/.local/share ~/.local/bin
if ! [ -d ~/.local/share/fzf ]; then
	git clone --depth 1 https://github.com/junegunn/fzf.git ~/.local/share/fzf
	~/.local/share/fzf/install --bin
fi
ln -sf ~/.local/share/fzf/bin/fzf ~/.local/bin/fzf
ln -sf ~/.local/share/fzf/bin/fzf-tmux ~/.local/bin/fzf-tmux

# General ~/.config directories
mkdir -p ~/.config
for app in bugwarrior gh ghostty hubtty k9s mc nvim ripgrep tridactyl vim; do
	if [ -d ~/dotfiles/.config/"$app" ]; then
		ln -sf ~/dotfiles/.config/"$app" ~/.config/"$app"
	fi
done

if command -v nvim >/dev/null 2>&1; then
	nvim --headless +PlugInstall +qall 2>/dev/null || true
elif command -v vim >/dev/null 2>&1; then
	vim +PlugInstall +qall 2>/dev/null || true
fi

# IRB config
mkdir -p ~/.config/irb
ln -sf ~/dotfiles/.config/irb/irbrc ~/.config/irb/irbrc

# Zsh custom modules
if [ -d ~/dotfiles/.config/zsh/custom ]; then
	ln -sf ~/dotfiles/.config/zsh/custom ~/.config/zsh/custom
fi

# Pi agent
mkdir -p ~/.pi/agent
for item in agents extensions themes AGENTS.md settings.json; do
	if [ -e ~/dotfiles/.pi/agent/"$item" ]; then
		ln -sf ~/dotfiles/.pi/agent/"$item" ~/.pi/agent/"$item"
	fi
done

# Local share data
mkdir -p ~/.local/share/mc
if [ -d ~/dotfiles/.local/share/hackon ]; then
	ln -sf ~/dotfiles/.local/share/hackon ~/.local/share/hackon
fi
if [ -d ~/dotfiles/.local/share/mc/skins ]; then
	ln -sf ~/dotfiles/.local/share/mc/skins ~/.local/share/mc/skins
fi

# Root dotfiles
for rc in .curlrc .inputrc .taskrc .wgetrc; do
	if [ -f ~/dotfiles/"$rc" ]; then
		ln -sf ~/dotfiles/"$rc" ~/"$rc"
	fi
done
EOF

chsh -s /bin/zsh martin
